{
  "chapter": 1,
  "title": "나의 뿌리",
  "questions": [
    { "id": "01-01", "text": "어디에서\n태어나셨어요?", "followUpHint": "그 동네의 풍경이 기억나시면\n들려주세요." },
    { "id": "01-02", "text": "어릴 적 집은\n어떤 곳이었어요?", "followUpHint": "방이나 마당처럼\n떠오르는 자리가 있으면요." },
    { "id": "01-03", "text": "부모님은\n어떤 분이셨어요?", "followUpHint": "부모님이 자주 하시던 말씀도\n궁금해요." },
    { "id": "01-04", "text": "형제자매와는\n어떻게 지내셨어요?", "followUpHint": "함께 했던 장난이나 다툼도\n좋아요." },
    { "id": "01-05", "text": "어린 시절\n가장 좋아하던 놀이는요?", "followUpHint": "누구와 함께 놀았는지도\n들려주세요." },
    { "id": "01-06", "text": "고향을 떠나던 날은\n기억나세요?", "followUpHint": "그때 마음이 어떠셨는지\n듣고 싶어요." }
  ]
}
