{
  "chapter": 4,
  "title": "가족",
  "questions": [
    { "id": "04-01", "text": "아내분은\n어떻게 만나셨어요?", "followUpHint": "처음 본 날의 인상도\n궁금해요." },
    { "id": "04-02", "text": "결혼식 날은\n어땠어요?", "followUpHint": "그날 기억나는 사람이 있으면\n들려주세요." },
    { "id": "04-03", "text": "아이가 태어나던 날,\n어디에 계셨어요?", "followUpHint": "그 소식을 처음 들었을 때\n어떠셨어요?" },
    { "id": "04-04", "text": "가족과 함께 간 여행 중\n가장 기억나는 곳은요?", "followUpHint": "그 길을 운전하던 이야기도\n좋아요." },
    { "id": "04-05", "text": "가족에게 꼭 남기고 싶은\n말이 있으세요?", "followUpHint": "천천히, 떠오르는 대로\n말씀해 주세요." }
  ]
}
