{
  "chapter": 5,
  "title": "길 위에서 만난 사람들",
  "questions": [
    { "id": "05-01", "text": "가장 기억에 남는\n손님은 누구였어요?", "followUpHint": "그분과 나눈 이야기도\n들려주세요." },
    { "id": "05-02", "text": "길에서 도움을 받은 적이\n있으세요?", "followUpHint": "그분께 하고 싶은 말이\n있다면요." },
    { "id": "05-03", "text": "오래 알고 지낸\n동료 기사님이 있으세요?", "followUpHint": "함께 밥을 먹던 곳도\n궁금해요." },
    { "id": "05-04", "text": "운전하다 만난\n잊지 못할 장면이 있어요?", "followUpHint": "그때 무슨 생각을 하셨는지\n듣고 싶어요." },
    { "id": "05-05", "text": "다시 만나고 싶은 사람이\n있으세요?", "followUpHint": "만나면 무슨 말을\n건네고 싶으세요?" }
  ]
}
