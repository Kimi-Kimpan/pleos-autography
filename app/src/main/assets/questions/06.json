{
  "chapter": 6,
  "title": "가장 길었던 밤",
  "questions": [
    { "id": "06-01", "text": "살면서 가장 길었던 밤은\n언제였어요?", "followUpHint": "그날 어디에 계셨는지부터\n들려주세요." },
    { "id": "06-02", "text": "그 밤에\n누가 곁에 있었어요?", "followUpHint": "그분이 해 준 말이\n기억나세요?" },
    { "id": "06-03", "text": "그 밤을\n어떻게 넘기셨어요?", "followUpHint": "버티게 해 준 무언가가\n있었나요?" },
    { "id": "06-04", "text": "그 밤이 지나고\n무엇이 달라졌어요?", "followUpHint": "지금 돌아보면\n어떤 마음이 드세요?" },
    { "id": "06-05", "text": "그때의 나에게\n해 주고 싶은 말이 있으세요?", "followUpHint": "짧아도 괜찮아요." }
  ]
}
